{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "api/**/*.ts",
    "src/lib/historicalDataRequest.ts",
    "src/lib/historicalDataResponse.ts",
    "src/lib/instrumentMetadata.ts",
    "src/lib/ohlcvData.ts",
    "src/lib/backtestApi.ts"
  ]
}
